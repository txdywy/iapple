---
import '../styles/global.css';
import appleData from '../data/generated/apple-updates.json';
import timelineData from '../data/generated/release-timeline.json';
import sourceStatuses from '../data/generated/data-source-status.json';
import { applePlatforms, type AppleUpdate, type DataSourceStatus, type ReleaseTimelineItem, type ApplePlatform } from '../types/apple-updates';

const updates = appleData.updates as AppleUpdate[];
const timeline = timelineData.items as ReleaseTimelineItem[];
const statuses = sourceStatuses as DataSourceStatus[];

const dateFormatter = new Intl.DateTimeFormat('en-US', {
  dateStyle: 'medium',
  timeStyle: 'short',
  timeZone: 'UTC'
});

function formatDate(value: string | null): string {
  if (!value) return 'Unavailable';
  const date = new Date(value);
  return Number.isNaN(date.getTime()) ? 'Unavailable' : `${dateFormatter.format(date)} UTC`;
}

function formatDateShort(value: string | null): string {
  if (!value) return 'Unavailable';
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return 'Unavailable';
  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}

// Group updates by platform
const groupedUpdates = applePlatforms.reduce((acc, platform) => {
  acc[platform] = updates.filter((u) => u.platform === platform);
  return acc;
}, {} as Record<ApplePlatform, AppleUpdate[]>);

// Count stats
const totalVersionsTracked = updates.length;
const successRate = Math.round((statuses.filter(s => s.status === 'ok').length / statuses.length) * 100);
const lastGenerated = formatDate(appleData.generatedAt);

function getReleaseTag(title: string) {
  const lower = title.toLowerCase();
  if (lower.includes('beta')) {
    return { label: 'Beta', color: 'bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500/20' };
  }
  if (lower.includes('release candidate') || lower.includes(' rc')) {
    return { label: 'RC', color: 'bg-purple-500/10 text-purple-600 dark:text-purple-400 border-purple-500/20' };
  }
  if (lower.includes('xcode') || lower.includes('connect api') || lower.includes('testflight')) {
    return { label: 'Tools', color: 'bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 border-indigo-500/20' };
  }
  return { label: 'Release', color: 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/20' };
}

const platformThemes: Record<ApplePlatform, { gradient: string; text: string; bg: string; shadow: string }> = {
  iOS: {
    gradient: 'from-blue-500 to-indigo-600',
    text: 'text-blue-600 dark:text-blue-400',
    bg: 'bg-blue-500/10',
    shadow: 'shadow-blue-500/10 dark:shadow-blue-500/5'
  },
  iPadOS: {
    gradient: 'from-cyan-500 to-blue-600',
    text: 'text-cyan-600 dark:text-cyan-400',
    bg: 'bg-cyan-500/10',
    shadow: 'shadow-cyan-500/10 dark:shadow-cyan-500/5'
  },
  macOS: {
    gradient: 'from-pink-500 to-rose-600',
    text: 'text-pink-600 dark:text-pink-400',
    bg: 'bg-pink-500/10',
    shadow: 'shadow-pink-500/10 dark:shadow-pink-500/5'
  },
  watchOS: {
    gradient: 'from-orange-500 to-amber-600',
    text: 'text-orange-600 dark:text-orange-400',
    bg: 'bg-orange-500/10',
    shadow: 'shadow-orange-500/10 dark:shadow-orange-500/5'
  },
  tvOS: {
    gradient: 'from-slate-600 to-slate-800 dark:from-slate-500 dark:to-slate-700',
    text: 'text-slate-600 dark:text-slate-400',
    bg: 'bg-slate-500/10',
    shadow: 'shadow-slate-500/10 dark:shadow-slate-500/5'
  },
  visionOS: {
    gradient: 'from-purple-500 to-violet-600',
    text: 'text-purple-600 dark:text-purple-400',
    bg: 'bg-purple-500/10',
    shadow: 'shadow-purple-500/10 dark:shadow-purple-500/5'
  }
};
---

<html lang="en" class="antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="A state-of-the-art dashboard tracking Apple software updates and developer releases in real-time." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>iApple Updates · Dashboard</title>

    <!-- Pre-render Theme Check (Eliminates FOUC) -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return 'system';
      })();
      const root = document.documentElement;
      if (theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        root.classList.add('dark');
      } else {
        root.classList.remove('dark');
      }
    </script>
  </head>
  <body class="transition-colors duration-300 min-h-screen text-slate-800 dark:text-slate-200">
    <!-- Navbar -->
    <header class="sticky top-0 z-50 glass-panel border-b border-slate-200/40 dark:border-slate-800/40">
      <div class="mx-auto max-w-6xl px-6 py-4 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <!-- Apple Logo SVG -->
          <svg class="w-6 h-6 fill-current text-slate-900 dark:text-white" viewBox="0 0 24 24">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-.1 3.81 1.48a4.88 4.88 0 0 1 3.04 4.51 4.75 4.75 0 0 1-2.34 4.18c.61.85.99 1.76.99 2.5 0 .1-.26.6-.9 1.26zm-3.6-13.88c.75-.91 1.25-2.18 1.11-3.44-1.08.04-2.4 0.72-3.18 1.63-.69.8-1.29 2.08-1.13 3.32 1.2.1 2.45-.6 3.2-1.51z"/>
          </svg>
          <span class="font-heading text-lg font-bold tracking-tight">iApple Updates</span>
        </div>

        <!-- Theme Selector (Light, Dark, System) -->
        <div class="flex items-center gap-1 p-1 bg-slate-200/50 dark:bg-slate-900/50 border border-slate-300/30 dark:border-slate-800/30 rounded-full text-xs">
          <button id="theme-btn-light" class="px-3 py-1.5 rounded-full transition-all duration-200 hover:text-slate-900 dark:hover:text-white flex items-center gap-1.5 font-medium">
            <svg class="w-3.5 h-3.5 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
            </svg>
            <span>Light</span>
          </button>
          <button id="theme-btn-dark" class="px-3 py-1.5 rounded-full transition-all duration-200 hover:text-slate-900 dark:hover:text-white flex items-center gap-1.5 font-medium">
            <svg class="w-3.5 h-3.5 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
            </svg>
            <span>Dark</span>
          </button>
          <button id="theme-btn-system" class="px-3 py-1.5 rounded-full transition-all duration-200 hover:text-slate-900 dark:hover:text-white flex items-center gap-1.5 font-medium">
            <svg class="w-3.5 h-3.5 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="14" x="2" y="3" rx="2"></rect>
              <line x1="8" x2="16" y1="21" y2="21"></line>
              <line x1="12" x2="12" y1="17" y2="21"></line>
            </svg>
            <span>System</span>
          </button>
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-6xl px-6 py-8 sm:py-12">
      <!-- Title & Statistics Grid -->
      <section class="grid gap-6 md:grid-cols-3 items-stretch">
        <!-- Main Banner -->
        <article class="md:col-span-2 rounded-[2rem] bg-gradient-to-tr from-slate-900 via-slate-950 to-slate-900 p-8 sm:p-10 text-white shadow-2xl relative overflow-hidden flex flex-col justify-between min-h-[220px]">
          <div class="absolute -right-16 -top-16 w-64 h-64 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>
          <div>
            <span class="text-xs font-semibold uppercase tracking-[0.25em] text-indigo-400">Live Status</span>
            <h1 class="mt-3 text-3xl sm:text-4xl font-heading font-extrabold tracking-tight">
              Apple software releases, refreshed automatically.
            </h1>
            <p class="mt-3 text-sm text-slate-300 leading-relaxed max-w-xl">
              Tracking iOS, iPadOS, macOS, watchOS, tvOS, and visionOS major and legacy active branches, sourced from official Apple servers.
            </p>
          </div>
          <p class="mt-6 text-xs text-slate-400 flex items-center gap-1.5">
            <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse-ring"></span>
            Last generated: {lastGenerated}
          </p>
        </article>

        <!-- Stats Card -->
        <article class="rounded-[2rem] glass-panel p-8 shadow-sm flex flex-col justify-between">
          <div class="space-y-4">
            <span class="text-xs font-semibold uppercase tracking-[0.25em] text-slate-500 dark:text-slate-400">Statistics</span>
            <div class="grid grid-cols-2 gap-4">
              <div class="p-4 rounded-2xl bg-slate-100/50 dark:bg-slate-900/40 border border-slate-200/50 dark:border-slate-800/50">
                <span class="block text-2xl font-bold font-heading text-indigo-600 dark:text-indigo-400">{totalVersionsTracked}</span>
                <span class="text-xs text-slate-500 dark:text-slate-400">Tracked Versions</span>
              </div>
              <div class="p-4 rounded-2xl bg-slate-100/50 dark:bg-slate-900/40 border border-slate-200/50 dark:border-slate-800/50">
                <span class="block text-2xl font-bold font-heading text-emerald-600 dark:text-emerald-400">{successRate}%</span>
                <span class="text-xs text-slate-500 dark:text-slate-400">Sources Healthy</span>
              </div>
            </div>
          </div>
          <div class="mt-4 pt-4 border-t border-slate-200/40 dark:border-slate-800/40 text-[11px] text-slate-400 leading-normal">
            Data aggregates Apple GDMF, SOFA macOS/iOS endpoints, and Developer Release feeds.
          </div>
        </article>
      </section>

      <!-- Controls Panel (Tabs & Search) -->
      <section class="mt-8 flex flex-col sm:flex-row gap-4 justify-between items-center bg-white/40 dark:bg-slate-950/40 border border-slate-200/50 dark:border-slate-800/50 p-3 rounded-2xl backdrop-blur-md">
        <!-- Tabs -->
        <div class="flex flex-wrap gap-1 w-full sm:w-auto">
          <button class="tab-btn px-4 py-2 rounded-xl text-xs font-semibold transition-all-custom bg-slate-900 text-white dark:bg-white dark:text-slate-950 shadow-sm" data-tab="all">
            All Platforms
          </button>
          {applePlatforms.map((platform) => {
            const count = groupedUpdates[platform].length;
            return (
              <button class="tab-btn px-4 py-2 rounded-xl text-xs font-medium text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-all-custom" data-tab={platform}>
                {platform}
                <span class="ml-1 px-1.5 py-0.5 rounded-md text-[10px] bg-slate-200/60 dark:bg-slate-800 text-slate-500 dark:text-slate-400 font-semibold font-mono">{count}</span>
              </button>
            )
          })}
        </div>

        <!-- Search Bar -->
        <div class="relative w-full sm:w-64">
          <input type="text" id="search-input" placeholder="Search versions, builds..." class="w-full pl-9 pr-4 py-2 text-xs rounded-xl border border-slate-200 dark:border-slate-800 bg-white/80 dark:bg-slate-900/80 text-slate-800 dark:text-slate-200 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/50" />
          <svg class="w-3.5 h-3.5 text-slate-400 absolute left-3 top-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
          </svg>
        </div>
      </section>

      <!-- Platforms Grid -->
      <section class="mt-6 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {applePlatforms.map((platform) => {
          const updatesList = groupedUpdates[platform];
          const latestUpdate = updatesList[0];
          const theme = platformThemes[platform];
          
          if (!latestUpdate) {
            return (
              <article class="platform-card rounded-3xl border border-slate-200/50 dark:border-slate-800/50 bg-white/80 dark:bg-slate-950/60 p-6 shadow-sm flex flex-col justify-between" data-platform={platform}>
                <div>
                  <div class="flex items-center justify-between">
                    <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">{platform}</span>
                  </div>
                  <p class="mt-6 text-sm text-slate-500 dark:text-slate-400">No updates currently tracked.</p>
                </div>
              </article>
            );
          }

          const previousBranches = updatesList.slice(1);

          return (
            <article class="platform-card rounded-3xl border border-slate-200/50 dark:border-slate-800/50 bg-white/80 dark:bg-slate-950/60 p-6 shadow-sm flex flex-col justify-between hover:shadow-md transition-all-custom" data-platform={platform}>
              <div>
                <!-- Card Header -->
                <div class="flex items-center justify-between">
                  <div>
                    <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">Platform</span>
                    <h2 class="text-lg font-heading font-bold text-slate-900 dark:text-white flex items-center gap-1.5">
                      {platform}
                    </h2>
                  </div>
                  <!-- Platform Icon container -->
                  <div class={`w-10 h-10 rounded-xl bg-gradient-to-tr ${theme.gradient} flex items-center justify-center text-white shadow-lg ${theme.shadow}`}>
                    {platform === 'iOS' && (
                      <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                        <path d="M17 2H7C5.34 2 4 3.34 4 5v14c0 1.66 1.34 3 3 3h10c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3zm-5 18c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm6-4H6V5h12v11z"/>
                      </svg>
                    )}
                    {platform === 'iPadOS' && (
                      <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                        <path d="M18 2H6C4.34 2 3 3.34 3 5v14c0 1.66 1.34 3 3 3h12c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3zm-6 19c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm7-4H5V4h14v13z"/>
                      </svg>
                    )}
                    {platform === 'macOS' && (
                      <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                        <path d="M21 2H3c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h7l-2 3v1h10v-1l-2-3h7c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 12H3V4h18v10z"/>
                      </svg>
                    )}
                    {platform === 'watchOS' && (
                      <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                        <path d="M8 6h8V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v1zm8 12H8v1a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2v-1zM5 9c0-1.66 1.34-3 3-3h8c1.66 0 3 1.34 3 3v6c0 1.66-1.34 3-3 3H8c-1.66 0-3-1.34-3-3V9z"/>
                      </svg>
                    )}
                    {platform === 'tvOS' && (
                      <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                        <path d="M21 3H3c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h5v2H6v2h12v-2h-2v-2h5c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 12H3V5h18v10z"/>
                      </svg>
                    )}
                    {platform === 'visionOS' && (
                      <svg class="w-5 h-5 fill-none stroke-current" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                        <path d="M2 9c0-1.5 1.5-2.5 3-2.5h14c1.5 0 3 1 3 2.5v4c0 1.5-1.5 2.5-3 2.5H5c-1.5 0-3-1-3-2.5V9z"/>
                        <circle cx="6.5" cy="11" r="1.5"/>
                        <circle cx="17.5" cy="11" r="1.5"/>
                        <path d="M10 11.5c1 0 1 .5 2 .5s1-.5 2-.5"/>
                      </svg>
                    )}
                  </div>
                </div>

                <!-- Latest Version Prominent Display -->
                <div class="mt-6">
                  <span class="text-xs font-semibold text-slate-400 dark:text-slate-500">Latest Release</span>
                  <div class="flex items-baseline gap-2 mt-1">
                    <h3 class="text-4xl font-heading font-extrabold tracking-tight text-slate-900 dark:text-white">{latestUpdate.version}</h3>
                    <span class="text-xs font-mono font-medium px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-900 border border-slate-200/50 dark:border-slate-800 text-slate-600 dark:text-slate-400">
                      {latestUpdate.build ?? 'No build'}
                    </span>
                  </div>
                </div>

                <!-- Latest Details list -->
                <dl class="mt-6 space-y-2.5 text-xs border-t border-slate-200/40 dark:border-slate-800/40 pt-4">
                  <div class="flex justify-between gap-4">
                    <dt class="text-slate-400">Release Date</dt>
                    <dd class="font-medium text-slate-800 dark:text-slate-200">{formatDateShort(latestUpdate.releaseDate)}</dd>
                  </div>
                  <div class="flex justify-between gap-4">
                    <dt class="text-slate-400">Source Feed</dt>
                    <dd class="font-medium text-slate-800 dark:text-slate-200 flex items-center gap-1.5">
                      <span class="inline-block w-1.5 h-1.5 rounded-full bg-indigo-500"></span>
                      {latestUpdate.source}
                    </dd>
                  </div>
                  <div class="flex justify-between gap-4">
                    <dt class="text-slate-400">Sync Status</dt>
                    <dd class="text-slate-500 font-mono text-[10px] relative-date" data-date={latestUpdate.fetchedAt}>
                      {formatDateShort(latestUpdate.fetchedAt)}
                    </dd>
                  </div>
                </dl>

                <!-- Previous Active Branches -->
                {previousBranches.length > 0 && (
                  <div class="mt-6 pt-4 border-t border-slate-200/40 dark:border-slate-800/40">
                    <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 block mb-3">Active Previous Branches</span>
                    <ul class="space-y-2">
                      {previousBranches.map((item) => (
                        <li class="flex items-center justify-between text-xs p-2 rounded-xl bg-slate-50/50 dark:bg-slate-900/30 border border-slate-100/50 dark:border-slate-900/50 hover:bg-slate-100/40 dark:hover:bg-slate-900/60 transition-colors">
                          <span class="font-semibold text-slate-700 dark:text-slate-300 font-heading">{item.version}</span>
                          <div class="flex items-center gap-2">
                            <span class="font-mono text-[10px] px-1.5 py-0.5 rounded bg-white dark:bg-slate-950 border border-slate-200/60 dark:border-slate-800 text-slate-500 dark:text-slate-400">
                              {item.build ?? 'No build'}
                            </span>
                            <span class="text-[10px] text-slate-400">{formatDateShort(item.releaseDate)}</span>
                          </div>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            </article>
          );
        })}
      </section>

      <!-- Timeline & Source Status -->
      <section class="mt-12 grid gap-8 lg:grid-cols-3">
        <!-- Release Timeline Column -->
        <article class="lg:col-span-2 rounded-3xl border border-slate-200/50 dark:border-slate-800/50 bg-white/80 dark:bg-slate-950/60 p-6 sm:p-8 shadow-sm flex flex-col">
          <div class="flex items-center justify-between border-b border-slate-200/40 dark:border-slate-800/40 pb-4">
            <div>
              <h2 class="text-xl font-heading font-extrabold text-slate-900 dark:text-white">Developer Release Feed</h2>
              <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Raw feeds from Apple Newsroom Releases RSS channel</p>
            </div>
            <span class="px-2 py-1 rounded-lg bg-slate-100 dark:bg-slate-900 text-slate-500 dark:text-slate-400 text-[10px] font-mono font-semibold">RSS Source</span>
          </div>

          <ol class="mt-6 relative border-l border-slate-200 dark:border-slate-800 pl-4 space-y-6">
            {timeline.length === 0 ? (
              <p class="text-sm text-slate-500 dark:text-slate-400">No release timeline items found.</p>
            ) : (
              timeline.map((item) => {
                const tag = getReleaseTag(item.title);
                return (
                  <li class="timeline-item group relative" data-title={item.title}>
                    <!-- Timeline Node Indicator -->
                    <span class="absolute -left-[21px] top-1.5 flex h-2.5 w-2.5 items-center justify-center rounded-full bg-slate-200 dark:bg-slate-800 ring-4 ring-white dark:ring-slate-950 group-hover:bg-indigo-500 group-hover:scale-125 transition-all duration-200"></span>
                    
                    <div class="flex flex-wrap items-center gap-2">
                      <span class={`px-2 py-0.5 rounded-full text-[9px] font-bold uppercase tracking-wider border ${tag.color}`}>
                        {tag.label}
                      </span>
                      <time class="text-[10px] text-slate-400 font-mono relative-date" data-date={item.publishedAt}>
                        {formatDateShort(item.publishedAt)}
                      </time>
                    </div>

                    <h3 class="mt-2 text-sm font-semibold text-slate-900 dark:text-white timeline-title">
                      {item.url ? (
                        <a class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-indigo-500" href={item.url} target="_blank" rel="noopener noreferrer">
                          {item.title}
                        </a>
                      ) : (
                        item.title
                      )}
                    </h3>
                  </li>
                )
              })
            )}
          </ol>
        </article>

        <!-- Data Source Status Column -->
        <article class="rounded-3xl border border-slate-200/50 dark:border-slate-800/50 bg-white/80 dark:bg-slate-950/60 p-6 shadow-sm flex flex-col justify-between">
          <div>
            <h2 class="text-xl font-heading font-extrabold text-slate-900 dark:text-white border-b border-slate-200/40 dark:border-slate-800/40 pb-4">Feed Status</h2>
            <div class="mt-6 space-y-4">
              {statuses.map((source) => (
                <div class="rounded-2xl border border-slate-200/30 dark:border-slate-800/30 bg-slate-50/50 dark:bg-slate-900/30 p-4">
                  <div class="flex items-center justify-between gap-4">
                    <h3 class="text-xs font-semibold text-slate-800 dark:text-slate-200">{source.name}</h3>
                    
                    <div class="flex items-center gap-2">
                      <span class={`w-1.5 h-1.5 rounded-full ${source.status === 'ok' ? 'bg-emerald-500 animate-pulse-ring' : 'bg-rose-500 animate-pulse-ring-error'}`}></span>
                      <span class={`rounded-full px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider ${
                        source.status === 'ok' 
                          ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400' 
                          : 'bg-rose-500/10 text-rose-600 dark:text-rose-400'
                      }`}>
                        {source.status}
                      </span>
                    </div>
                  </div>
                  
                  {source.message ? (
                    <div class="mt-3 p-2.5 rounded-xl bg-rose-500/5 border border-rose-500/10 text-[10px] text-rose-500 leading-normal break-words font-mono">
                      {source.message}
                    </div>
                  ) : (
                    <p class="mt-2 text-[10px] text-slate-400 font-mono relative-date" data-date={source.fetchedAt}>
                      Updated: {formatDateShort(source.fetchedAt)}
                    </p>
                  )}
                </div>
              ))}
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-slate-200/40 dark:border-slate-800/40 text-center">
            <span class="text-[10px] text-slate-400">Refreshed hourly via GitHub Actions</span>
          </div>
        </article>
      </section>
    </main>

    <!-- Footer -->
    <footer class="mt-16 border-t border-slate-200/40 dark:border-slate-800/40 py-8 text-center text-xs text-slate-400">
      <div class="mx-auto max-w-6xl px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
        <p>© {new Date().getFullYear()} iApple Updates. Open source project.</p>
        <div class="flex items-center gap-4">
          <a href="https://github.com/iapple/iapple" target="_blank" rel="noopener noreferrer" class="hover:text-slate-800 dark:hover:text-white transition-colors flex items-center gap-1">
            <!-- GitHub SVG -->
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.579.688.481C19.137 20.162 22 16.418 22 12c0-5.523-4.477-10-10-10z"/>
            </svg>
            GitHub
          </a>
        </div>
      </div>
    </footer>

    <!-- Client-side Interactive Script -->
    <script>
      // 1. Theme Selector Implementation
      const themeBtns = {
        light: document.getElementById('theme-btn-light'),
        dark: document.getElementById('theme-btn-dark'),
        system: document.getElementById('theme-btn-system')
      };

      function applyTheme(theme) {
        localStorage.setItem('theme', theme);
        const root = document.documentElement;
        
        // Remove existing theme state classes
        Object.values(themeBtns).forEach(btn => {
          if (btn) {
            btn.classList.remove('bg-white', 'text-slate-950', 'dark:bg-slate-800', 'dark:text-white', 'shadow-sm');
            btn.classList.add('text-slate-600', 'dark:text-slate-400');
          }
        });

        // Set active button style and apply classes
        const activeBtn = themeBtns[theme];
        if (activeBtn) {
          activeBtn.classList.remove('text-slate-600', 'dark:text-slate-400');
          activeBtn.classList.add('bg-white', 'text-slate-950', 'dark:bg-slate-800', 'dark:text-white', 'shadow-sm');
        }

        if (theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          root.classList.add('dark');
        } else {
          root.classList.remove('dark');
        }
      }

      // Initial Theme Button Setup
      const savedTheme = localStorage.getItem('theme') || 'system';
      applyTheme(savedTheme);

      // Event Listeners for Theme Switching
      themeBtns.light?.addEventListener('click', () => applyTheme('light'));
      themeBtns.dark?.addEventListener('click', () => applyTheme('dark'));
      themeBtns.system?.addEventListener('click', () => applyTheme('system'));

      // Listen for system preference changes when in 'system' mode
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
        if (localStorage.getItem('theme') === 'system') {
          applyTheme('system');
        }
      });


      // 2. Relative Dates Calculation
      function getRelativeTimeString(dateStr) {
        if (!dateStr) return '';
        const date = new Date(dateStr);
        if (isNaN(date.getTime())) return '';
        
        const now = new Date();
        const diffMs = now.getTime() - date.getTime();
        const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
        
        if (diffDays === 0) {
          const diffHours = Math.floor(diffMs / (1000 * 60 * 60));
          if (diffHours === 0) {
            const diffMins = Math.floor(diffMs / (1000 * 60));
            return diffMins <= 1 ? 'Just now' : `${diffMins}m ago`;
          }
          return `${diffHours}h ago`;
        }
        
        if (diffDays === 1) return 'Yesterday';
        if (diffDays < 7) return `${diffDays}d ago`;
        if (diffDays < 30) {
          const weeks = Math.floor(diffDays / 7);
          return `${weeks}w ago`;
        }
        
        return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
      }

      // Enhance dynamic dates
      document.querySelectorAll('.relative-date').forEach(el => {
        const dateStr = el.getAttribute('data-date');
        const relativeStr = getRelativeTimeString(dateStr);
        if (relativeStr) {
          el.textContent = relativeStr;
        }
      });


      // 3. Search and Platform Tabs Filter
      const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
      const tabBtns = document.querySelectorAll('.tab-btn');
      const platformCards = document.querySelectorAll('.platform-card');
      const timelineItems = document.querySelectorAll('.timeline-item');

      let currentTab = 'all';
      let currentQuery = '';

      function updateFilters() {
        // Filter platform cards
        platformCards.forEach(card => {
          const platform = card.getAttribute('data-platform');
          const content = card.textContent?.toLowerCase() || '';
          
          const matchesTab = currentTab === 'all' || platform === currentTab;
          const matchesSearch = content.includes(currentQuery);
          
          if (matchesTab && matchesSearch) {
            (card as HTMLElement).style.display = '';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });

        // Filter timeline items
        timelineItems.forEach(item => {
          const title = item.getAttribute('data-title')?.toLowerCase() || '';
          const matchesSearch = title.includes(currentQuery);
          
          if (matchesSearch) {
            (item as HTMLElement).style.display = '';
          } else {
            (item as HTMLElement).style.display = 'none';
          }
        });
      }

      // Search Event Listener
      searchInput?.addEventListener('input', (e) => {
        currentQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
        updateFilters();
      });

      // Tab Buttons Click Handlers
      tabBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          // Update active button state styling
          tabBtns.forEach(b => {
            b.classList.remove('bg-slate-900', 'text-white', 'dark:bg-white', 'dark:text-slate-950', 'shadow-sm');
            b.classList.add('text-slate-600', 'dark:text-slate-400');
          });
          
          btn.classList.remove('text-slate-600', 'dark:text-slate-400');
          btn.classList.add('bg-slate-900', 'text-white', 'dark:bg-white', 'dark:text-slate-950', 'shadow-sm');

          currentTab = btn.getAttribute('data-tab') || 'all';
          updateFilters();
        });
      });
    </script>
  </body>
</html>
